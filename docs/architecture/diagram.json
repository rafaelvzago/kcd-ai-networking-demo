  "tooltips": {
    "istioGw": {
      "title": "Istio Gateway",
      "description": "Recebe POST /v1/chat/completions e aplica as HTTPRoutes anexadas. Se nenhuma regra corresponder, retorna HTTP 404.",
      "details": [["API", "POST /v1/chat/completions"], ["Rotas", "fast-route e quality-route"]]
    },
    "routeFast": {
      "title": "HTTPRoute fast-route",
      "description": "Corresponde ao caminho /v1/chat/completions e ao cabeçalho X-Demo-Pool: fast; o backendRef aponta para o InferencePool fast-router.",
      "details": [["Cabeçalho", "X-Demo-Pool: fast"], ["backendRef", "InferencePool fast-router"]]
    },
    "routeQuality": {
      "title": "HTTPRoute quality-route",
      "description": "Corresponde ao caminho /v1/chat/completions e ao cabeçalho X-Demo-Pool: quality; o backendRef aponta para o InferencePool quality-router.",
      "details": [["Cabeçalho", "X-Demo-Pool: quality"], ["backendRef", "InferencePool quality-router"]]
    },
    "poolFast": {
      "title": "InferencePool fast-router",
      "description": "Agrupa os pods com app: fast-simulator. O EPP associado escolhe um deles para atender cada requisição.",
      "details": [["Seletor", "app: fast-simulator"], ["Pods", "3"], ["EPP", "fast-router-epp"]]
    },
    "poolQuality": {
      "title": "InferencePool quality-router",
      "description": "Agrupa o pod com app: quality-simulator. O EPP associado seleciona esse endpoint.",
      "details": [["Seletor", "app: quality-simulator"], ["Pods", "1"], ["EPP", "quality-router-epp"]]
    },
    "eppFast": {
      "title": "Endpoint Picker fast-router-epp",
      "description": "O Endpoint Picker do llm-d escolhe um dos três pods da InferencePool fast-router; a demo não promete uma ordem fixa de escolha.",
      "details": [["Pool", "fast-router"], ["Endpoints elegíveis", "3 pods fast-simulator"]]
    },
    "eppQuality": {
      "title": "Endpoint Picker quality-router-epp",
      "description": "O Endpoint Picker do llm-d seleciona o único pod da InferencePool quality-router.",
      "details": [["Pool", "quality-router"], ["Endpoint elegível", "1 pod quality-simulator"]]
    },
    "modeloRapido": {
      "title": "Modelo rápido",
      "description": "Três pods de llm-d-inference-sim respondem no formato compatível com OpenAI, incluindo usage. O TTFT configurado é 100 ms.",
      "details": [["Imagem", "llm-d-inference-sim"], ["Réplicas", "3"], ["TTFT configurado", "100 ms"]]
    },
    "modeloQualidade": {
      "title": "Modelo de qualidade",
      "description": "Um pod separado de llm-d-inference-sim responde no formato compatível com OpenAI, incluindo usage. O TTFT configurado é 500 ms.",
      "details": [["Imagem", "llm-d-inference-sim"], ["Réplicas", "1"], ["TTFT configurado", "500 ms"]]
    }
  },
  "flows": {
    "overview": {
      "label": "InferencePool — visão geral",
      "steps": [
        { "text": "O cliente envia requisições de inferência para o Istio Gateway.", "mode": "arrow", "from": "client", "to": "istioGw", "color": "#58a6ff", "num": 1, "fromRight": true, "toLeft": true },
        { "text": "X-Demo-Pool: fast corresponde à HTTPRoute fast-route.", "mode": "arrow", "from": "istioGw", "to": "routeFast", "color": "#58a6ff", "num": 2, "fromTop": true, "toBottom": true },
        { "text": "fast-route aponta para a InferencePool fast-router.", "mode": "arrow", "from": "routeFast", "to": "poolFast", "color": "#f0883e", "num": 3, "fromRight": true, "toLeft": true },
        { "text": "O EPP fast-router escolhe um pod elegível da pool.", "mode": "arrow", "from": "poolFast", "to": "eppFast", "color": "#d2a8ff", "num": 4, "fromRight": true, "toLeft": true },
        { "text": "O modelo rápido é servido por três pods, com TTFT configurado de 100 ms.", "mode": "arrow", "from": "eppFast", "to": "modeloRapido", "color": "#58a6ff", "num": 5, "fromRight": true, "toLeft": true },
        { "text": "X-Demo-Pool: quality corresponde à HTTPRoute quality-route.", "mode": "arrow", "from": "istioGw", "to": "routeQuality", "color": "#58a6ff", "num": 6, "fromBottom": true, "toTop": true },
        { "text": "quality-route aponta para a InferencePool quality-router.", "mode": "arrow", "from": "routeQuality", "to": "poolQuality", "color": "#f0883e", "num": 7, "fromRight": true, "toLeft": true },
        { "text": "O EPP quality-router seleciona o endpoint da pool.", "mode": "arrow", "from": "poolQuality", "to": "eppQuality", "color": "#d2a8ff", "num": 8, "fromRight": true, "toLeft": true },
        { "text": "O modelo de qualidade é servido por um pod, com TTFT configurado de 500 ms.", "mode": "arrow", "from": "eppQuality", "to": "modeloQualidade", "color": "#58a6ff", "num": 9, "fromRight": true, "toLeft": true },
        { "text": "Outro valor de X-Demo-Pool não encontra rota e o Gateway devolve 404.", "mode": "lightup", "target": "istioGw", "badge": "404", "errColor": "#f85149" }
      ]
    },
    "fast_happy_path": {
      "label": "Modelo rápido",
      "steps": [
        { "text": "Cliente envia POST /v1/chat/completions com model: fast e X-Demo-Pool: fast.", "mode": "arrow", "from": "client", "to": "istioGw", "color": "#58a6ff", "num": 1, "fromRight": true, "toLeft": true },
        { "text": "O Gateway encontra a HTTPRoute fast-route pelo caminho e pelo cabeçalho.", "mode": "arrow", "from": "istioGw", "to": "routeFast", "color": "#58a6ff", "num": 2, "fromTop": true, "toBottom": true },
        { "text": "O backendRef da rota seleciona a InferencePool fast-router.", "mode": "arrow", "from": "routeFast", "to": "poolFast", "color": "#f0883e", "num": 3, "fromRight": true, "toLeft": true },
        { "text": "O Gateway consulta o EPP da pool para selecionar o endpoint.", "mode": "arrow", "from": "poolFast", "to": "eppFast", "color": "#d2a8ff", "num": 4, "fromRight": true, "toLeft": true },
        { "text": "O EPP escolhe um dos três pods fast-simulator.", "mode": "arrow", "from": "eppFast", "to": "modeloRapido", "color": "#58a6ff", "num": 5, "fromRight": true, "toLeft": true },
        { "text": "O simulador responde no formato OpenAI, com usage e TTFT configurado de 100 ms.", "mode": "arrow", "from": "modeloRapido", "to": "istioGw", "color": "#3fb950", "num": 6, "fromBottom": true, "toLeft": true, "waypoints": [{ "x": 1320, "y": 695 }, { "x": 240, "y": 695 }, { "x": 240, "y": 440 }] },
        { "text": "O Gateway devolve a resposta ao cliente.", "mode": "arrow", "from": "istioGw", "to": "client", "color": "#3fb950", "num": 7, "fromLeft": true, "toRight": true, "yOff": 14 }
      ]
    },
    "quality_happy_path": {
      "label": "Modelo de qualidade",
      "steps": [
        { "text": "Cliente envia POST /v1/chat/completions com model: quality e X-Demo-Pool: quality.", "mode": "arrow", "from": "client", "to": "istioGw", "color": "#58a6ff", "num": 1, "fromRight": true, "toLeft": true },
        { "text": "O Gateway encontra a HTTPRoute quality-route pelo caminho e pelo cabeçalho.", "mode": "arrow", "from": "istioGw", "to": "routeQuality", "color": "#58a6ff", "num": 2, "fromBottom": true, "toTop": true },
        { "text": "O backendRef da rota seleciona a InferencePool quality-router.", "mode": "arrow", "from": "routeQuality", "to": "poolQuality", "color": "#f0883e", "num": 3, "fromRight": true, "toLeft": true },
        { "text": "O Gateway consulta o EPP da pool para selecionar o endpoint.", "mode": "arrow", "from": "poolQuality", "to": "eppQuality", "color": "#d2a8ff", "num": 4, "fromRight": true, "toLeft": true },
        { "text": "O EPP seleciona o único pod quality-simulator.", "mode": "arrow", "from": "eppQuality", "to": "modeloQualidade", "color": "#58a6ff", "num": 5, "fromRight": true, "toLeft": true },
        { "text": "O simulador responde no formato OpenAI, com usage e TTFT configurado de 500 ms.", "mode": "arrow", "from": "modeloQualidade", "to": "istioGw", "color": "#3fb950", "num": 6, "fromBottom": true, "toLeft": true, "waypoints": [{ "x": 1320, "y": 695 }, { "x": 240, "y": 695 }, { "x": 240, "y": 440 }] },
        { "text": "O Gateway devolve a resposta ao cliente.", "mode": "arrow", "from": "istioGw", "to": "client", "color": "#3fb950", "num": 7, "fromLeft": true, "toRight": true, "yOff": 14 }
      ]
    },
    "invalid_pool": {
      "label": "Pool inválido",
      "steps": [
        { "text": "Cliente envia POST /v1/chat/completions com X-Demo-Pool diferente de fast e quality.", "mode": "arrow", "from": "client", "to": "istioGw", "color": "#58a6ff", "num": 1, "fromRight": true, "toLeft": true },
        { "text": "Nenhuma HTTPRoute corresponde; o Gateway retorna HTTP 404 sem acessar InferencePool ou EPP.", "mode": "lightup", "target": "istioGw", "badge": "404", "errColor": "#f85149" },
        { "text": "O cliente recebe HTTP 404.", "mode": "arrow", "from": "istioGw", "to": "client", "color": "#f85149", "num": 3, "fromLeft": true, "toRight": true, "yOff": 14 }
      ]
    }
  },
  "legend": [
    { "label": "Requisição", "color": "#58a6ff" },
    { "label": "Resposta", "color": "#3fb950" },
    { "label": "Seleção de pool", "color": "#f0883e" },
    { "label": "Seleção de pod", "color": "#d2a8ff" },
    { "label": "Erro", "color": "#f85149" },
    { "label": "Infraestrutura", "color": "#8b949e" }
  ],
  "flowOrder": ["overview", "fast_happy_path", "quality_happy_path", "invalid_pool"],
  "defaultFlow": "overview"
}
