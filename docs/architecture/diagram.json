  "tooltips": {
    "istioGw": {
      "title": "Istio Gateway",
      "description": "Ponto de entrada do cluster via Gateway API. Recebe as requisições OpenAI-compatible POST /v1/chat/completions e as encaminha para o roteamento de inferência.",
      "details": [
        ["Rota", "POST /v1/chat/completions"],
        ["Camada", "Istio + Gateway API"]
      ]
    },
    "ipp": {
      "title": "Inference Payload Processor (IPP)",
      "description": "Lê o campo model do corpo da requisição e o cabeçalho X-Demo-Pool para selecionar de forma explícita a InferencePool correspondente.",
      "details": [
        ["Lê", "model + X-Demo-Pool"],
        ["Decide", "InferencePool fast | quality"]
      ]
    },
    "poolFast": {
      "title": "InferencePool fast",
      "description": "Pool de inferência rápida. Balanceia entre três réplicas do simulador, com tempo até o primeiro token (TTFT) de 100 ms.",
      "details": [
        ["Réplicas", "3"],
        ["TTFT", "100 ms"],
        ["Header", "X-Demo-Pool: fast"]
      ]
    },
    "poolQuality": {
      "title": "InferencePool quality",
      "description": "Pool de inferência de qualidade. Direciona para uma única réplica do simulador, com TTFT de 500 ms.",
      "details": [
        ["Réplicas", "1"],
        ["TTFT", "500 ms"],
        ["Header", "X-Demo-Pool: quality"]
      ]
    },
    "modeloRapido": {
      "title": "Modelo rápido",
      "description": "Três réplicas de llm-d-inference-sim que retornam respostas OpenAI-compatible, incluindo o campo usage. Otimizado para latência baixa.",
      "details": [
        ["Simulador", "llm-d-inference-sim"],
        ["Réplicas", "3"],
        ["TTFT", "100 ms"]
      ]
    },
    "modeloQualidade": {
      "title": "Modelo de qualidade",
      "description": "Uma réplica separada de llm-d-inference-sim que retorna respostas OpenAI-compatible, incluindo o campo usage.",
      "details": [
        ["Simulador", "llm-d-inference-sim"],
        ["Réplicas", "1"],
        ["TTFT", "500 ms"]
      ]
    }
  },
  "flows": {
    "fast_happy_path": {
      "label": "Modelo rápido",
      "steps": [
        { "text": "Cliente envia requisição OpenAI-compatible POST /v1/chat/completions.", "mode": "arrow", "from": "client", "to": "istioGw", "color": "#58a6ff", "num": 1, "fromRight": true, "toLeft": true, "yOff": -10 },
        { "text": "Istio Gateway recebe e encaminha a requisição.", "mode": "arrow", "from": "istioGw", "to": "gaie", "color": "#58a6ff", "num": 2, "fromRight": true, "toLeft": true, "glow": "cLlmd" },
        { "text": "GAIE / llm-d Router Gateway processa a requisição de inferência.", "mode": "arrow", "from": "gaie", "to": "router", "color": "#58a6ff", "num": 3 },
        { "text": "IPP lê o campo model e o header X-Demo-Pool: fast.", "mode": "arrow", "from": "router", "to": "ipp", "color": "#58a6ff", "num": 4 },
        { "text": "IPP seleciona a InferencePool fast.", "mode": "arrow", "from": "ipp", "to": "poolFast", "color": "#f0883e", "num": 5 },
        { "text": "A pool fast escolhe uma das três réplicas do simulador rápido.", "mode": "arrow", "from": "poolFast", "to": "modeloRapido", "color": "#58a6ff", "num": 6, "fromRight": true, "toLeft": true },
        { "text": "O simulador responde com conteúdo OpenAI-compatible, usage e TTFT de 100 ms.", "mode": "arrow", "from": "modeloRapido", "to": "istioGw", "color": "#3fb950", "num": 7, "fromBottom": true, "toBottom": true, "waypoints": [{ "x": 1195, "y": 760 }, { "x": 325, "y": 760 }] },
        { "text": "A resposta retorna pelo Istio Gateway até o cliente.", "mode": "arrow", "from": "istioGw", "to": "client", "color": "#3fb950", "num": 8, "fromLeft": true, "toRight": true, "yOff": 14 }
      ]
    },
    "quality_happy_path": {
      "label": "Modelo de qualidade",
      "steps": [
        { "text": "Cliente envia requisição OpenAI-compatible POST /v1/chat/completions.", "mode": "arrow", "from": "client", "to": "istioGw", "color": "#58a6ff", "num": 1, "fromRight": true, "toLeft": true, "yOff": -10 },
        { "text": "Istio Gateway recebe e encaminha a requisição.", "mode": "arrow", "from": "istioGw", "to": "gaie", "color": "#58a6ff", "num": 2, "fromRight": true, "toLeft": true, "glow": "cLlmd" },
        { "text": "GAIE / llm-d Router Gateway processa a requisição de inferência.", "mode": "arrow", "from": "gaie", "to": "router", "color": "#58a6ff", "num": 3 },
        { "text": "IPP lê o campo model e o header X-Demo-Pool: quality.", "mode": "arrow", "from": "router", "to": "ipp", "color": "#58a6ff", "num": 4 },
        { "text": "IPP seleciona a InferencePool quality.", "mode": "arrow", "from": "ipp", "to": "poolQuality", "color": "#f0883e", "num": 5 },
        { "text": "A requisição chega ao único simulador de qualidade.", "mode": "arrow", "from": "poolQuality", "to": "modeloQualidade", "color": "#58a6ff", "num": 6, "fromRight": true, "toLeft": true },
        { "text": "O simulador retorna conteúdo OpenAI-compatible, usage e TTFT de 500 ms.", "mode": "arrow", "from": "modeloQualidade", "to": "istioGw", "color": "#3fb950", "num": 7, "fromBottom": true, "toBottom": true, "waypoints": [{ "x": 1185, "y": 775 }, { "x": 325, "y": 775 }] },
        { "text": "A resposta retorna pelo Istio Gateway até o cliente.", "mode": "arrow", "from": "istioGw", "to": "client", "color": "#3fb950", "num": 8, "fromLeft": true, "toRight": true, "yOff": 14 }
      ]
    },
    "invalid_pool": {
      "label": "Pool inválido",
      "steps": [
        { "text": "Cliente envia requisição com X-Demo-Pool inválido.", "mode": "arrow", "from": "client", "to": "istioGw", "color": "#58a6ff", "num": 1, "fromRight": true, "toLeft": true },
        { "text": "A requisição chega ao IPP/router através do Istio Gateway.", "mode": "arrow", "from": "istioGw", "to": "ipp", "color": "#58a6ff", "num": 2, "fromRight": true, "toLeft": true, "glow": "cLlmd" },
        { "text": "Falha de roteamento: nenhuma InferencePool corresponde ao X-Demo-Pool informado.", "mode": "lightup", "target": "ipp", "badge": "X", "errColor": "#f85149" },
        { "text": "Uma resposta de erro é retornada ao cliente.", "mode": "arrow", "from": "ipp", "to": "client", "color": "#f85149", "num": 4, "fromLeft": true, "toRight": true, "waypoints": [{ "x": 480, "y": 700 }, { "x": 30, "y": 700 }] }
      ]
    }
  },
  "legend": [
    { "label": "Requisição", "color": "#58a6ff" },
    { "label": "Resposta", "color": "#3fb950" },
    { "label": "Decisão de roteamento", "color": "#f0883e" },
    { "label": "Erro", "color": "#f85149" },
    { "label": "Infraestrutura", "color": "#8b949e" }
  ],
  "flowOrder": ["fast_happy_path", "quality_happy_path", "invalid_pool"],
  "defaultFlow": "fast_happy_path"
}
