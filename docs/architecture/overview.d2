direction: down

classes: {
  workload: { style: { fill: "#E8F0FE"; stroke: "#1A73E8"; border-radius: 8 } }
  service: { style: { fill: "#E6F4EA"; stroke: "#188038"; border-radius: 8 } }
  routing: { style: { fill: "#FFF3E0"; stroke: "#E37400"; border-radius: 8 } }
  config: { style: { fill: "#F3E8FD"; stroke: "#9334E6"; border-radius: 8 } }
}

caller: "Port-forward client or client-app" {
  class: workload
  tooltip: "README and validation scripts use a port-forward or curl from the client-app Pod."
}

kind: "Kind cluster: kcd-ai-networking-demo" {
  style.fill: "#F8F9FA"
  style.stroke: "#5F6368"

  platform: "agentgateway-system namespace" {
    style.fill: "#FFF8E1"
    agentgateway: "Agentgateway\nHelm release; inference extension enabled" { class: routing }
  }

  app: "ai-networking-demo namespace" {
    style.fill: "#FFFFFF"

    gateway: "Gateway\nllm-d-inference-gateway\nAgentgateway HTTP :80" {
      class: routing
      tooltip: "GatewayClass is agentgateway; it accepts same-namespace routes."
    }
    default_pool: "llm-d Router / InferencePool\nmock-llm-router\napp=mock-llm" { class: routing }
    fast_pool: "llm-d Router / InferencePool\ndemo-fast-router\nmodel=demo-fast" { class: routing }
    quality_pool: "llm-d Router / InferencePool\ndemo-quality-router\nmodel=demo-quality" { class: routing }
    backend_1: "backend-1\nDeployment • 1 Pod\nmock-llm :8080\nmodel=demo-fast" { class: workload }
    backend_2: "backend-2\nDeployment • 1 Pod\nmock-llm :8080\nmodel=demo-fast" { class: workload }
    backend_3: "backend-3\nDeployment • 1 Pod\nmock-llm :8080\nmodel=demo-quality" { class: workload }
    egress: "Egress route\negress.local /v1/chat/completions\n20 tokens / minute" { class: config }
    secret: "Secret: upstream-api-key\nAuthorization: demo-key" { class: config }
    upstream_service: "Service: external-mock-llm\nHTTP :8080" { class: service }
    upstream: "external-mock-llm\nDeployment • 1 Pod\nREQUIRED_API_KEY" { class: workload }
    policy: "Model routing configuration\nextract-model: body.model → x-model\nHTTPRoute → AgentgatewayBackend" { class: config }
  }
}

caller -> kind.app.gateway: "HTTP POST /v1/chat/completions"
kind.platform.agentgateway -> kind.app.gateway: "GatewayClass / control plane"
kind.app.gateway -> kind.app.default_pool: "default inference route"
kind.app.gateway -> kind.app.policy: "PreRouting"
kind.app.policy -> kind.app.fast_pool: "demo-fast"
kind.app.policy -> kind.app.quality_pool: "demo-quality"
kind.app.default_pool -> kind.app.backend_1: "HTTP :8080"
kind.app.default_pool -> kind.app.backend_2: "HTTP :8080"
kind.app.default_pool -> kind.app.backend_3: "HTTP :8080"
kind.app.fast_pool -> kind.app.backend_1: "HTTP :8080"
kind.app.fast_pool -> kind.app.backend_2: "HTTP :8080"
kind.app.quality_pool -> kind.app.backend_3: "HTTP :8080"
kind.app.gateway -> kind.app.egress: "Host: egress.local"
kind.app.egress -> kind.app.upstream_service: "AgentgatewayBackend; HTTP :8080"
kind.app.upstream_service -> kind.app.upstream: "HTTP :8080"
kind.app.secret -> kind.app.egress: "auth secretRef"
kind.app.secret -> kind.app.upstream: "REQUIRED_API_KEY"
