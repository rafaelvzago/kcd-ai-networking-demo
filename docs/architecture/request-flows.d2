direction: down

inference: "1. InferencePool: default pool" {
  shape: sequence_diagram
  client: "client-app or port-forward client"
  gateway: "Agentgateway Gateway"
  pool: "mock-llm-router InferencePool"
  backend: "backend-1 | backend-2 | backend-3"

  client -> gateway: "POST /v1/chat/completions"
  gateway -> pool: "HTTPRoute created by llm-d chart"
  pool -> backend: "HTTP :8080; selected mock backend"
  backend -> pool: "OpenAI-compatible response; usage + cache headers"
  pool -> gateway: "response"
  gateway -> client: "response"
}

model_routing: "2. Model routing: separate pools" {
  shape: sequence_diagram
  client: "client-app"
  gateway: "Agentgateway Gateway"
  policy: "extract-model policy"
  fast: "demo-fast-router"
  quality: "demo-quality-router"
  fast_backends: "backend-1 or backend-2"
  quality_backend: "backend-3"

  client -> gateway: "POST body.model = demo-fast | demo-quality"
  gateway -> policy: "PreRouting"
  policy -> gateway: "set x-model from JSON body"
  gateway -> fast: "x-model=demo-fast"
  fast -> fast_backends: "HTTP :8080"
  gateway -> quality: "x-model=demo-quality"
  quality -> quality_backend: "HTTP :8080"
}

egress: "3. Egress: credential injection and quota" {
  shape: sequence_diagram
  client: "client-app"
  gateway: "Agentgateway Gateway"
  limit: "egress-token-limit"
  backend: "external-mock-llm AgentgatewayBackend"
  secret: "upstream-api-key Secret"
  upstream: "external-mock-llm Service / Pod"

  client -> gateway: "HTTP Host: egress.local; no Authorization"
  gateway -> limit: "HTTPRoute egress-chat; 20 tokens/minute"
  limit -> backend: "allowed request"
  backend -> secret: "reads auth secretRef"
  backend -> upstream: "HTTP :8080 + Bearer demo-key"
  upstream -> backend: "response with usage.total_tokens"
  backend -> limit: "response"
  limit -> gateway: "200, or 429 once quota is exceeded"
  gateway -> client: "response"
}
