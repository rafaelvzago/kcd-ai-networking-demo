[0.607128, "o", "\r\n\r\n=== 7. Pods consumidores ===\r\n"]
[0.603301, "o", "\r\nAgora conferimos os dois Pods, seus nós e o vínculo com os ResourceClaims.\r\n"]
[0.602774, "o", "\r\n$ kubectl --context kind-dra-demo --namespace dra-demo get pods -o wide\r\n"]
[0.041799, "o", "NAME                       READY   STATUS    RESTARTS   AGE   IP           NODE               NOMINATED NODE   READINESS GATES\r\n"]
[0.000109, "o", "dra-consumer-a             1/1     Running   0          12m   \u001b[1;31m10.244.1.3\u001b[0m   dra-demo-worker    <none>           <none>\r\ndra-consumer-b             1/1     Running   0          12m   \u001b[1;31m10.244.2.3\u001b[0m   dra-demo-worker2   <none>           <none>\r\n"]
[0.000093, "o", "dra-example-\u001b[1;31mdriver\u001b[0m-n2smv   1/1     Running   0          13m   \u001b[1;31m10.244.2.2\u001b[0m   dra-demo-worker2   <none>           <none>\r\ndra-example-\u001b[1;31mdriver\u001b[0m-zlwd4   1/1     Running   0          13m   \u001b[1;31m10.244.1.2\u001b[0m   dra-demo-worker    <none>           <none>\r\n"]
[0.605965, "o", "\r\n\r\n=== 8. Dentro de dra-consumer-a: GPU mock e rede ===\r\n"]
[0.602205, "o", "\r\nA variável GPU_DEVICE_* confirma a alocação da GPU; ip addr confirma a interface dranet0 e seu endereço.\r\n"]
[0.602803, "o", "\r\n$ kubectl --context kind-dra-demo --namespace dra-demo exec dra-consumer-a -- sh -c env | grep \"^GPU_DEVICE_\" || true; ip addr\r\n"]
[0.118961, "o", "\u001b[1;31mGPU_DEVICE_0_TIMESLICE_INTERVAL\u001b[0m=Default\r\n\u001b[1;31mGPU_DEVICE_0\u001b[0m=gpu-0\r\n\u001b[1;31mGPU_DEVICE_GPU_0_RESOURCE_CLAIM\u001b[0m=69242d45-56f9-4534-86af-d158263e89b6\r\n"]
[0.000013, "o", "\u001b[1;31mGPU_DEVICE_0_SHARING_STRATEGY\u001b[0m=TimeSlicing\r\n"]
[0.001959, "o", "1: lo: <LOOPBACK,UP,LOWER_UP> mtu 65536 qdisc noqueue qlen 1000\r\n    link/loopback 00:00:00:00:00:00 brd 00:00:00:00:00:00\r\n"]
[0.000106, "o", "    inet \u001b[1;31m127.0.0.1/8\u001b[0m scope host lo\r\n       valid_lft forever preferred_lft forever\r\n    inet6 ::1/128 scope host \r\n"]
[0.000005, "o", "       valid_lft forever preferred_lft forever\r\n2: eth0@if5: <BROADCAST,MULTICAST,UP,LOWER_UP,M-DOWN> mtu 1500 qdisc noqueue qlen 1000\r\n"]
[0.00002, "o", "    link/ether 56:0c:bc:c2:43:3a brd ff:ff:ff:ff:ff:ff\r\n"]
[0.000058, "o", "    inet \u001b[1;31m10.244.1.3/24\u001b[0m brd \u001b[1;31m10.244.1.255\u001b[0m scope global eth0\r\n       valid_lft forever preferred_lft forever\r\n    inet6 fe80::540c:bcff:fec2:433a/64 scope link \r\n"]
[0.000014, "o", "       valid_lft forever preferred_lft forever\r\n"]
[0.000092, "o", "4: \u001b[1;31mdranet0\u001b[0m: <BROADCAST,NOARP,UP,LOWER_UP> mtu 1500 qdisc noqueue qlen 1000\r\n    link/ether 7a:c5:58:0b:cc:6e brd ff:ff:ff:ff:ff:ff\r\n"]
[0.000064, "o", "    inet \u001b[1;31m169.254.10.1/30\u001b[0m brd \u001b[1;31m169.254.10.3\u001b[0m scope global \u001b[1;31mdranet0\u001b[0m\r\n       valid_lft forever preferred_lft forever\r\n    inet6 fe80::78c5:58ff:fe0b:cc6e/64 scope link \r\n       valid_lft forever preferred_lft forever\r\n"]
