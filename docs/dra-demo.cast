[0.005462, "o", "\r\n\r\n=== 1. Visão geral do cluster ===\r\n"]
[0.60269, "o", "\r\nComeçamos pelos nós para confirmar onde os drivers e os Pods podem ser executados.\r\n"]
[0.603194, "o", "\r\n$ kubectl --context kind-dra-demo get nodes -o wide\r\n"]
[0.073012, "o", "NAME                     STATUS   ROLES           AGE   VERSION   INTERNAL-IP   EXTERNAL-IP   OS-IMAGE                       KERNEL-VERSION                  CONTAINER-RUNTIME\r\n"]
[0.000197, "o", "dra-demo-control-plane   Ready    control-plane   13m   v1.37.0   \u001b[1;31m172.18.0.4\u001b[0m    <none>        Debian GNU/Linux 13 (trixie)   7.2.5-200.fc44.x86_64 (amd64)   containerd://2.3.4\r\n"]
[0.000008, "o", "dra-demo-worker          Ready    <none>          13m   v1.37.0   \u001b[1;31m172.18.0.5\u001b[0m    <none>        Debian GNU/Linux 13 (trixie)   7.2.5-200.fc44.x86_64 (amd64)   containerd://2.3.4\r\n"]
[0.000042, "o", "dra-demo-worker2         Ready    <none>          13m   v1.37.0   \u001b[1;31m172.18.0.2\u001b[0m    <none>        Debian GNU/Linux 13 (trixie)   7.2.5-200.fc44.x86_64 (amd64)   containerd://2.3.4\r\n"]
[0.610241, "o", "\r\n\r\n=== 2. Drivers DRA em execução ===\r\n"]
[0.603237, "o", "\r\nOs DaemonSets publicam a GPU mock e os devices de rede; ambos são somente consultados aqui.\r\n"]
[0.603335, "o", "\r\n$ kubectl --context kind-dra-demo --namespace dra-demo get daemonset,pods\r\n"]
[0.076832, "o", "NAME                                DESIRED   CURRENT   READY   UP-TO-DATE   AVAILABLE   NODE SELECTOR   AGE\r\n"]
[0.000091, "o", "daemonset.apps/dra-example-\u001b[1;31mdriver\u001b[0m   2         2         2       2            2           <none>          13m\r\n"]
[0.000594, "o", "\r\n"]
[0.000035, "o", "NAME                           READY   STATUS    RESTARTS   AGE\r\n"]
[0.000048, "o", "pod/dra-consumer-a             1/1     Running   0          12m\r\n"]
[0.000014, "o", "pod/dra-consumer-b             1/1     Running   0          12m\r\n"]
[0.00005, "o", "pod/dra-example-\u001b[1;31mdriver\u001b[0m-n2smv   1/1     Running   0          13m\r\n"]
[0.000021, "o", "pod/dra-example-\u001b[1;31mdriver\u001b[0m-zlwd4   1/1     Running   0          13m\r\n"]
[0.609557, "o", "\r\n$ kubectl --context kind-dra-demo --namespace kube-system get daemonset,pods -l app=dranet\r\n"]
[0.079877, "o", "NAME                    DESIRED   CURRENT   READY   UP-TO-DATE   AVAILABLE   NODE SELECTOR   AGE\r\n"]
[0.000046, "o", "daemonset.apps/dranet   2         2         2       2            2           <none>          12m\r\n"]
[0.000494, "o", "\r\n"]
[0.00002, "o", "NAME               READY   STATUS    RESTARTS   AGE\r\n"]
[0.000066, "o", "pod/dranet-n9xbn   1/1     Running   0          12m\r\npod/dranet-nnlmz   1/1     Running   0          12m\r\n"]
[0.610432, "o", "\r\n\r\n=== 3. DeviceClass: quais devices podem ser selecionados ===\r\n"]
[0.602934, "o", "\r\nEstas classes ligam os claims aos drivers gpu.example.com e dra.net.\r\n"]
[0.602888, "o", "\r\n$ kubectl --context kind-dra-demo get deviceclass gpu.example.com dranet.net -o yaml\r\n"]
